# ============================================================
# 🌸 MAATRUMITRA ENVIRONMENT CONFIGURATION
# ============================================================

# Backend Port (Default: 5000)
PORT=5000

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Optional for Demo Mode)
# If left empty, MaatruMitra automatically activates its built-in memory/mock storage engine!
# Local MongoDB: mongodb://localhost:27017/maatrumitra
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/maatrumitra?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret for Session Authentication
JWT_SECRET=maatrumitra_super_secure_jwt_secret_dev_key_2026

# AI Assistant API Key (Optional for Demo Mode)
# If left empty, MaatruMitra uses its built-in intelligent pregnancy wellness knowledge engine!
# Optional: GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=

# Node Environment
NODE_ENV=development
